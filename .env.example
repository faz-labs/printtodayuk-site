# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional Firestore Database ID (defaults to '(default)')
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# AWS S3 & CloudFront Configuration (Folder: 'Print Today')
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-west-2
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_CLOUDFRONT_DOMAIN=your_distribution.cloudfront.net
